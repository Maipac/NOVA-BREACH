            VALUE "FileDescription", "NOVA BREACH"
            VALUE "ProductName", "NOVA BREACH"
            VALUE "FileVersion", "1.1.0"
            VALUE "ProductVersion", "1.1.0"
            VALUE "OriginalFilename", "NovaBreach.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
